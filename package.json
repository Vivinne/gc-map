{
  "name": "gc-atlas",
  "version": "0.1.0",
  "private": true,
  "description": "General Culture buildings atlas: map, timeline and review",
  "scripts": {
    "data": "node scripts/build-data.mjs && node scripts/build-basemap.mjs",
    "predev": "npm run data",
    "dev": "next dev",
    "prebuild": "npm run data",
    "build": "next build",
    "site": "npm run data && node scripts/build-standalone.mjs",
    "serve": "python3 -m http.server 3000 --directory out",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "e2e": "node tests/e2e/run.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "d3-geo": "^3.1.1",
    "maplibre-gl": "^5.6.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/topojson-client": "^3.1.5",
    "esbuild": "^0.25.0",
    "playwright": "^1.55.0",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20.9"
  }
}
